{
  "type": "module",
  "scripts": {
    "pretest": "node --import tsx pretest.ts",
    "posttest": "node --import tsx posttest.ts",
    "test": "node --import tsx --test",
    "test:all": "CONCURRENCY=${CONCURRENCY:-$(docker info --format '{{.NCPU}}' | awk '{print int($1/2)}')} npm run test -- --test-concurrency=$CONCURRENCY *.test.ts",
    "chromium": "node --import tsx release/browsers/chromium.ts",
    "webkit": "node --import tsx release/browsers/webkit.ts",
    "firefox": "node --import tsx release/browsers/firefox.ts"
  },
  "dependencies": {
    "dockerode": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.13",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "chrome-remote-interface": "^0.34.0",
    "devtools-protocol": "^0.0.1619965",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0"
  }
}
